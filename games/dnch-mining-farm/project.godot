; DNCH MINING FARM - Android tycoon
config_version=5

[application]
config/name="DNCH MINING FARM"
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/description="Build a hardware mining empire in a living 3D facility."
config/icon="res://art/icon_192.png"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[input_devices]
pointing/emulate_mouse_from_touch=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.031, 0.08, 0.12, 1)

[physics]
3d/default_gravity=9.8
